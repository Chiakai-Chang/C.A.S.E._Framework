{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case-agent.dev/schema/0.1.0-preview/checks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["dossier_id", "content_digest", "observed_evidence_digest", "invariant_results", "criterion_results", "stable_warning_codes", "verdict"],
  "properties": {
    "dossier_id": { "$ref": "definitions.schema.json#/$defs/opaque_id" },
    "content_digest": { "$ref": "definitions.schema.json#/$defs/digest" },
    "observed_evidence_digest": { "$ref": "definitions.schema.json#/$defs/digest" },
    "invariant_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status"],
        "properties": {
          "code": { "type": "string" },
          "status": { "enum": ["passed", "failed"] }
        }
      }
    },
    "criterion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "supporting_evidence_ids"],
        "properties": {
          "criterion_id": { "$ref": "definitions.schema.json#/$defs/opaque_id" },
          "status": { "enum": ["mechanically_satisfied", "human_review_required", "failed"] },
          "supporting_evidence_ids": { "$ref": "definitions.schema.json#/$defs/opaque_id_array" }
        }
      }
    },
    "stable_warning_codes": { "$ref": "definitions.schema.json#/$defs/string_array" },
    "verdict": { "enum": ["passed", "failed"] }
  }
}
