{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case-agent.local/conformance/rules.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rule_id",
      "source_section",
      "statement",
      "requires_positive",
      "requires_negative"
    ],
    "properties": {
      "rule_id": {
        "type": "string",
        "pattern": "^M0-[A-Z]+-[0-9]{3}$"
      },
      "source_section": {
        "type": "string",
        "pattern": "^(?:[6-9]|1[0-9]|2[0-4])(?:\\.[0-9]+)?$"
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "requires_positive": {
        "type": "boolean"
      },
      "requires_negative": {
        "type": "boolean"
      }
    }
  }
}
