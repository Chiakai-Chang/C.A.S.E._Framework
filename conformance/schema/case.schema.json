{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case-agent.local/conformance/case.schema.json",
  "$defs": {
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tree_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_file", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "content_file": { "$ref": "#/$defs/safe_path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "fixed_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CASE_CLOCK",
        "CASE_ID_SEED",
        "CASE_PROCESS_PROFILE",
        "CASE_PROCESS_PID",
        "CASE_PROCESS_STARTED_AT",
        "CASE_PROCESS_STATUS",
        "CASE_NETWORK",
        "LANG",
        "LC_ALL",
        "TZ"
      ],
      "properties": {
        "CASE_CLOCK": { "type": "string", "minLength": 1 },
        "CASE_ID_SEED": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "CASE_PROCESS_PROFILE": { "const": "controlled-test" },
        "CASE_PROCESS_PID": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "CASE_PROCESS_STARTED_AT": { "type": "string", "minLength": 1 },
        "CASE_PROCESS_STATUS": { "enum": ["terminated", "live", "unknown"] },
        "CASE_NETWORK": { "const": "deny" },
        "LANG": { "const": "C" },
        "LC_ALL": { "const": "C" },
        "TZ": { "const": "UTC" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_label",
        "argv",
        "stdin_mode",
        "stdin_content_file",
        "fixed_environment",
        "concurrency_group",
        "fault_point"
      ],
      "properties": {
        "actor_label": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "stdin_mode": { "enum": ["none", "fixed_text", "interactive_script"] },
        "stdin_content_file": {
          "oneOf": [
            { "$ref": "#/$defs/safe_path" },
            { "type": "null" }
          ]
        },
        "fixed_environment": { "$ref": "#/$defs/fixed_environment" },
        "concurrency_group": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            { "type": "null" }
          ]
        },
        "fault_point": {
          "enum": [
            null,
            "after_temp_open",
            "after_temp_flush",
            "after_envelope_create",
            "after_snapshot_replace"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "stdin_mode": { "const": "none" } }, "required": ["stdin_mode"] },
          "then": { "properties": { "stdin_content_file": { "type": "null" } } },
          "else": { "properties": { "stdin_content_file": { "$ref": "#/$defs/safe_path" } } }
        }
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_exit", "result_code", "stdout_json_file", "stderr"],
      "properties": {
        "process_exit": { "type": "integer", "minimum": 0, "maximum": 255 },
        "result_code": { "type": "string", "pattern": "^CASE_(?:OK|E_[A-Z_]+)$" },
        "stdout_json_file": {
          "oneOf": [
            { "$ref": "#/$defs/safe_path" },
            { "type": "null" }
          ]
        },
        "stderr": { "enum": ["empty", "startup_failure_only"] }
      },
      "allOf": [
        {
          "if": { "properties": { "stderr": { "const": "empty" } }, "required": ["stderr"] },
          "then": { "properties": { "stdout_json_file": { "$ref": "#/$defs/safe_path" } } },
          "else": { "properties": { "stdout_json_file": { "type": "null" } } }
        }
      ]
    },
    "tree_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "presence", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "presence": { "enum": ["present", "absent"] },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "presence": { "const": "present" } }, "required": ["presence"] },
          "then": { "properties": { "sha256": { "$ref": "#/$defs/digest" } } },
          "else": { "properties": { "sha256": { "type": "null" } } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "case_id",
    "normative_rule_ids",
    "applicable_platform_profiles",
    "initial_tree",
    "invocations",
    "expected",
    "expected_final_tree",
    "expected_derived_view_file"
  ],
  "properties": {
    "fixture_version": { "const": "1" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "normative_rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^M0-[A-Z]+-[0-9]{3}$" }
    },
    "applicable_platform_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["controlled-test", "production-windows-unsupported", "production-posix-unclaimed"] }
    },
    "initial_tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/tree_input" }
    },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invocation" }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expectation" }
    },
    "expected_final_tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/tree_expectation" }
    },
    "expected_derived_view_file": {
      "oneOf": [
        { "$ref": "#/$defs/safe_path" },
        { "type": "null" }
      ]
    }
  }
}
