{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case-agent.local/conformance/interactive-script.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["script_version", "steps"],
  "properties": {
    "script_version": { "const": "1" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "expected_prompt_file", "response"],
        "properties": {
          "kind": { "enum": ["basis", "decision", "recovery"] },
          "expected_prompt_file": { "type": "string", "minLength": 1 },
          "response": { "type": "string" }
        }
      }
    }
  }
}
